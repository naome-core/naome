<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>NAOME third-party licenses</title></head>
<body><h1>NAOME third-party licenses</h1>
<p>Ordinary node dependencies, including build dependencies. The package also contains SYSTEM_LICENSES.txt.</p>
<h2>Components</h2><ul>
{{#each crates}}<li>{{package.name}} {{package.version}}: {{license}}</li>{{/each}}
</ul><h2>License texts and notices</h2>
{{#each licenses}}<h3>{{name}}</h3><ul>
{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}
</ul><pre>{{text}}</pre>{{/each}}
</body></html>
