# A different valid certificate of H's exact statement, for substitution in B.
foundation = "naome:zfc"
formulas:
    e = equal(x, x)
statement = forall(x, e)
proof:
    p0 = equality_reflexivity(x)
    p1 = simplification(e, e)
    p2 = modus_ponens(p0, p1)
    p3 = modus_ponens(p0, p2)
    p4 = generalization(p3, x)
    return p4
