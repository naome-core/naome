# Replacement instantiated for the identity relation.
foundation "naome:zfc";

theorem identity_image_exists {
  statement
    (forall source
      (implies
        (forall input
          (implies
            (member input source)
            (exists output
              (and
                (equal input output)
                (forall witness
                  (implies
                    (equal input witness)
                    (equal witness output)))))))
        (exists result
          (forall output
            (iff
              (member output result)
              (exists input
                (and
                  (member input source)
                  (equal input output))))))));

  proof {
    step image =
      (replacement
        (equal input output)
        input output witness source result
        (parameters));

    result image;
  }
}
