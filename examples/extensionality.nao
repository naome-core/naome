# Extensionality: sets with exactly the same members are equal.
foundation "naome:zfc";

theorem same_members_are_equal {
  statement
    (forall x (forall y
      (implies
        (forall z (iff (member z x) (member z y)))
        (equal x y))));

  proof {
    step axiom = (zfc-axiom extensionality);
    result axiom;
  }
}
