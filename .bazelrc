# All execution and caching stay on the local machine or standard CI runner.
common --enable_bzlmod
build --jobs=4
build --disk_cache=~/.cache/naome-bazel/disk
build --repository_cache=~/.cache/naome-bazel/repository
build --verbose_failures
test --test_output=errors
test --test_summary=detailed
# Compile only the numerical test kernels efficiently; retain debug guards.
test --@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__gemm@-Copt-level=2
test --@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__gemm@-Cdebug-assertions=on
test --@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__gemm@-Coverflow-checks=on

build:ci --keep_going
# Native-model regressions need optimized code, with all Rust runtime checks.
build:ci --compilation_mode=opt
build:ci --@rules_rust//rust/settings:extra_rustc_flag=-Copt-level=1
build:ci --@rules_rust//rust/settings:extra_rustc_flag=-Cdebug-assertions=yes
build:ci --@rules_rust//rust/settings:extra_rustc_flag=-Coverflow-checks=yes
test:ci --flaky_test_attempts=1
# Keep CPU-heavy native-model tests from flooding timed async fixtures.
test:ci --test_arg=--test-threads=2
