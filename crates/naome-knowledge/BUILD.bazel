load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "naome_knowledge",
    # Cargo.toml is authoritative; the CI build contract checks this mirror.
    version = "0.1.0-alpha.1",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [
        "src/learning/curriculum.json",
        "src/learning/curriculum/composition-retired.json",
        "src/learning/curriculum/owned-exclusions.json",
    ],
    edition = "2024",
    lint_config = ":cargo_lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        "//crates/naome-checker:naome_checker",
        "//crates/naome-foundation:naome_foundation",
        "//crates/naome-storage:naome_storage",
        "//crates/naome-proof:naome_proof",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    size = "medium",
    args = ["--skip=learning::model::preservation::tests::"],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":naome_knowledge",
    compile_data = [
        "//crates/naome-checker:src/tests/fixtures/identity_unique.proof.hex",
        "//crates/naome-checker:tests/fixtures/membership-witness.program",
        "src/learning/adaptive-protocol.json",
        "src/learning/experiment/finding/comparison/longitudinal/protocol.json",
        "src/learning/recovery-protocol.json",
        "tests/fixtures/checked-learning-library.json",
        "tests/fixtures/lemma-loop-questions.json",
        "tests/fixtures/native-fragment-capacity.json",
        "tests/fixtures/recursive-lemma-loop.json",
    ] + glob(["tests/fixtures/typed-membership/*.proof", "tests/fixtures/typed-membership/*.question"]),
    env = {"RUST_TEST_THREADS": "2"},
    lint_config = ":cargo_lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

native_test(
    name = "preservation_tests",
    size = "medium",
    # Reuse the compiled crate, keeping this CPU training process exclusive.
    tags = ["exclusive"],
    args = ["learning::model::preservation::tests::"],
    env = {"RUST_TEST_THREADS": "2"},
    src = ":unit_tests",
)

rust_binary(
    name = "naome",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "naome",
    crate_root = "src/main.rs",
    edition = "2024",
    lint_config = ":cargo_lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        ":naome_knowledge",
        "//crates/naome-proof-loop:naome_proof_loop",
        "//crates/naome-checker:naome_checker",
        "//crates/naome-foundation:naome_foundation",
        "//crates/naome-storage:naome_storage",
        "//crates/naome-proof:naome_proof",
    ] + all_crate_deps(normal = True),
)
