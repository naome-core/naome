# Equality substitution followed by explicit closure of every free variable.


goal = all(
    x,
    all(
        y,
        all(
            set,
            imp(
                eq(x, y),
                imp(mem(x, set), mem(y, set)),
            ),
        ),
    ),
)

proof:
    p0 = subst(x, y, mem(x, set))
    p1 = gen(p0, set)
    p2 = gen(p1, y)
    p3 = gen(p2, x)
    return p3
