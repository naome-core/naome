# Equality substitution followed by explicit closure of every free variable.
foundation = "naome:zfc"

statement = forall(
    x,
    forall(
        y,
        forall(
            set,
            implies(
                equal(x, y),
                implies(member(x, set), member(y, set)),
            ),
        ),
    ),
)

proof:
    p0 = equality_substitution(x, y, member(x, set))
    p1 = generalization(p0, set)
    p2 = generalization(p1, y)
    p3 = generalization(p2, x)
    return p3
