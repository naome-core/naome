# Separation constructs the intersection selected by an explicit parameter.


goal = all(
    filter,
    all(
        source,
        ex(
            result,
            all(
                element,
                iff(
                    mem(element, result),
                    and(mem(element, source), mem(element, filter)),
                ),
            ),
        ),
    ),
)

proof:
    p0 = sep(
        mem(element, filter),
        element,
        source,
        result,
        parameters=[filter],
    )
    return p0
