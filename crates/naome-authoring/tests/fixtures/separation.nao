# Separation constructs the intersection selected by an explicit parameter.
foundation = "naome:zfc"

statement = forall(
    filter,
    forall(
        source,
        exists(
            result,
            forall(
                element,
                iff(
                    member(element, result),
                    and_(member(element, source), member(element, filter)),
                ),
            ),
        ),
    ),
)

proof:
    p0 = separation(
        member(element, filter),
        element,
        source,
        result,
        parameters=[filter],
    )
    return p0
