

defs:
    self_equal = "0196e76ee0ecabbe9e863a19f191ded87b599a4b158c52f75d8ece35ba796035"
    holds = "4165ac271695531751ada582517549ab2e53d286a820b03de7ac3a0ddc372d19"
    same_members = "29b9cbdea19bdc3ee48f3f4cdebbd4deb07aaf4669564c4440163a857fcbf548"

goal = all(a, all(set,
    imp(holds(a, set), holds(a, set))
))

proof:
    p0 = cite("c617c9222df901d99404868aab415e917af76ce65699876342fe0c0ff1e62e73")
    p1 = cite("6e35a728527633573509b24fa20cb2359a14c1f93e9f6b6f1500f8650f731720")
    p2 = cite("dad1eccea41c54d5618a35bff0bc3b8fb52e0489017fd9a444cdae14355b6285")
    p3 = cite("e89dcbf998af185fd368a2531e2f0ee4953cc2232ec93da38ed3e89e21cede71")
    p4 = cite("7db633cf3f2a73749e143c3f26a0083b17c39e8a24c8940f64471cf6b49d515d")

    p5 = simp(
        all(x, eq(x, x)),
        all(y, eq(y, y)),
    )
    p6 = mp(p0, p5)
    p7 = mp(p1, p6)

    p8 = inst(x, a, self_equal(x,))
    p9 = mp(p7, p8)

    p10 = inst(
        x,
        a,
        imp(self_equal(x), self_equal(x)),
    )
    p11 = mp(p2, p10)
    p12 = mp(p9, p11)

    p13 = simp(
        self_equal(a),
        all(x, all(y,
            imp(
                same_members(x, y),
                eq(x, y),
            ),
        )),
    )
    p14 = mp(p12, p13)
    p15 = mp(p4, p14)

    p16 = inst(
        x,
        a,
        all(y, all(s,
            imp(
                eq(x, y),
                imp(holds(x, s), holds(y, s)),
            ),
        )),
    )
    p17 = mp(p3, p16)

    p18 = inst(
        y,
        a,
        all(s,
            imp(
                eq(a, y),
                imp(holds(a, s), holds(y, s)),
            ),
        ),
    )
    p19 = mp(p17, p18)

    p20 = inst(
        s,
        set,
        imp(
            self_equal(a),
            imp(holds(a, s), holds(a, s)),
        ),
    )
    p21 = mp(p19, p20)

    p22 = mp(p15, p21)
    p23 = gen(p22, set)
    p24 = gen(p23, a)
    return p24
