# Replacement instantiated for the identity relation.


goal = all(
    source,
    imp(
        all(
            input,
            imp(
                mem(input, source),
                ex(
                    output,
                    and(
                        eq(input, output),
                        all(
                            witness,
                            imp(
                                eq(input, witness),
                                eq(witness, output),
                            ),
                        ),
                    ),
                ),
            ),
        ),
        ex(
            result,
            all(
                output,
                iff(
                    mem(output, result),
                    ex(
                        input,
                        and(mem(input, source), eq(input, output)),
                    ),
                ),
            ),
        ),
    ),
)

proof:
    p0 = replace(
        eq(input, output),
        input,
        output,
        witness,
        source,
        result,
        parameters=[],
    )
    return p0
