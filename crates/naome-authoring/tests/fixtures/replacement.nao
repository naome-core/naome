# Replacement instantiated for the identity relation.
foundation = "naome:zfc"

statement = forall(
    source,
    implies(
        forall(
            input,
            implies(
                member(input, source),
                exists(
                    output,
                    and_(
                        equal(input, output),
                        forall(
                            witness,
                            implies(
                                equal(input, witness),
                                equal(witness, output),
                            ),
                        ),
                    ),
                ),
            ),
        ),
        exists(
            result,
            forall(
                output,
                iff(
                    member(output, result),
                    exists(
                        input,
                        and_(member(input, source), equal(input, output)),
                    ),
                ),
            ),
        ),
    ),
)

proof:
    p0 = replacement(
        equal(input, output),
        input,
        output,
        witness,
        source,
        result,
        parameters=[],
    )
    return p0
