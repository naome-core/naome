

defs:
    identity = "1b976399f4226292fdea6b89c496e976cbcd86eb1458bc265cdd14e04d1cf854"

goal = all(x,
    imp(
        eq(identity(x,), x),
        imp(eq(identity(x,), x), eq(identity(x,), x)),
    ),
)

proof:
    p0 = simp(
        eq(identity(x,), x),
        eq(identity(x,), x),
    )
