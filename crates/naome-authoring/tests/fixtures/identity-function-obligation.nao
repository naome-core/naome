    p56 = mp(p55, p52)
    p57 = frege(not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), imp(not(not(imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))))), not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y))))))))), imp(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y))))))), not(imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))))))
