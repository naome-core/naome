    p46 = frege(imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))), imp(not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x))))))), imp(not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))))
    p47 = simp(imp(imp(not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x))))))), imp(not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x))))))), imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))))
    p48 = frege(imp(not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x))))))), imp(not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y))))))), imp(not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))))
