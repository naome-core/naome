    p51 = frege(not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))), all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))
