    p53 = simp(imp(imp(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y))))))), not(imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))))), imp(imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))), all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))), not(not(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))))
    p54 = contra(imp(all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))), not(and(eq(x, x), all(z, imp(eq(z, x), eq(z, x)))))), all(y, not(and(eq(y, x), all(z, imp(eq(z, x), eq(z, y)))))))
