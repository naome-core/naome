    p0 = refl(x)
    p1 = frege(eq(z, x), imp(eq(x, x), eq(z, x)), eq(z, x))
    p2 = simp(eq(z, x), imp(eq(x, x), eq(z, x)))
    p3 = mp(p2, p1)
    p4 = simp(eq(z, x), eq(x, x))
    p5 = mp(p4, p3)
    p6 = gen(p5, z)
    p7 = frege(eq(x, x), imp(not(not(imp(eq(x, x), not(all(z, imp(eq(z, x), eq(z, x))))))), not(all(z, imp(eq(z, x), eq(z, x))))), imp(all(z, imp(eq(z, x), eq(z, x))), not(imp(eq(x, x), not(all(z, imp(eq(z, x), eq(z, x))))))))
