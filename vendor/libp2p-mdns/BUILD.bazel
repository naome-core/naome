load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
)

rust_library(
    name = "libp2p_mdns",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        [
            "src/**/*.hex",
            "tests/fixtures/**",
        ],
        allow_empty = True,
    ),
    crate_features = ["tokio"],
    edition = "2021",
    lint_config = ":cargo_lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    size = "medium",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":libp2p_mdns",
    lint_config = ":cargo_lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)
